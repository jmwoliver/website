---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { ABOUT, SITE } from "@consts";
---

<PageLayout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <h1 class="text-2xl font-semibold text-black dark:text-white">About</h1>
      <article>
        <p>
          Hello! I'm Jacob Woliver. I'm a software engineer at <Link href="https://posit.co/" external>Posit</Link>,
          where I build data science tools and mainly work on Package Manager.
        </p>
        <p>
          I enjoy making neat bits and bobs, learning how systems work, and writing about the ideas
          and trade-offs I encounter along the way.
        </p>
        <p>
          You can find me on <Link href="https://github.com/jmwoliver" external>GitHub</Link> or email me at
          <Link href={`mailto:${SITE.EMAIL}`}>{SITE.EMAIL}</Link>.
        </p>
      </article>
    </div>
  </Container>
</PageLayout>
