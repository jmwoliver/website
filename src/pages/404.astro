---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import PageLayout from "@layouts/PageLayout.astro";
---

<PageLayout title="Page not found" description="The requested page could not be found." canonicalPath="/404.html" noindex>
  <Container>
    <div class="space-y-4">
      <p class="text-sm">404</p>
      <h1 class="text-3xl font-semibold text-black dark:text-white">Page not found</h1>
      <p>That page does not exist, or it may have moved.</p>
      <Link href="/">Return home</Link>
    </div>
  </Container>
</PageLayout>
