---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import Link from "@components/Link.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { entrySlug } from "@lib/utils";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter((project) => !project.data.draft);
  return projects.map((project) => ({ params: { slug: entrySlug(project.id) }, props: project }));
}

type Props = CollectionEntry<"projects">;
const project = Astro.props;
const { Content } = await render(project);
---

<PageLayout title={project.data.title} description={project.data.description}>
  <Container>
    <div class="mb-10 space-y-8">
      <Link href="/projects/">&larr; Back to projects</Link>
      <header class="space-y-2">
        <FormattedDate date={project.data.date} />
        <h1 class="text-3xl font-semibold leading-tight text-black dark:text-white">{project.data.title}</h1>
        <p>{project.data.description}</p>
        <nav class="flex flex-wrap gap-x-3" aria-label="Project links">
          {project.data.demoURL && <Link href={project.data.demoURL} external>Demo</Link>}
          {project.data.repoURL && <Link href={project.data.repoURL} external>Source</Link>}
          {project.data.writeupURL && <Link href={project.data.writeupURL}>Write-up</Link>}
        </nav>
      </header>
    </div>
    <article><Content /></article>
  </Container>
</PageLayout>
