---
import type { CollectionEntry } from "astro:content";
import { entrySlug } from "@lib/utils";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};

const { entry } = Astro.props;
const isProject = entry.collection === "projects";
const href = isProject ? (entry.data.demoURL ?? entry.data.repoURL) : `/blog/${entrySlug(entry.id)}/`;
---

<a
  href={href}
  target={isProject ? "_blank" : undefined}
  rel={isProject ? "noopener noreferrer" : undefined}
  class="group flex items-start justify-between gap-5 border-b border-ink/10 py-3 transition-colors hover:border-ink/30 hover:text-ink dark:border-paper/10 dark:hover:border-paper/30 dark:hover:text-paper"
>
  <span class="min-w-0">
    <span class="block font-semibold">{entry.data.title}</span>
    <span class="mt-1 block text-sm leading-6">{entry.data.description}</span>
  </span>
  <span aria-hidden="true" class="mt-0.5 shrink-0 transition-transform group-hover:translate-x-1">{isProject ? "↗" : "→"}</span>
</a>
