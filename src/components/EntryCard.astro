---
import type { CollectionEntry } from "astro:content";
import { entrySlug } from "@lib/utils";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};

const { entry } = Astro.props;
---

<a
  href={`/${entry.collection}/${entrySlug(entry.id)}/`}
  class="group flex items-start justify-between gap-5 border-b border-black/10 py-3 transition-colors hover:border-black/30 hover:text-black dark:border-white/10 dark:hover:border-white/30 dark:hover:text-white"
>
  <span class="min-w-0">
    <span class="block font-semibold">{entry.data.title}</span>
    <span class="mt-1 block text-sm leading-6">{entry.data.description}</span>
  </span>
  <span aria-hidden="true" class="mt-0.5 shrink-0 transition-transform group-hover:translate-x-1">&rarr;</span>
</a>
