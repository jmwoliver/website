<div class="flex items-center gap-1" aria-label="Color theme">
  <button type="button" data-theme="light" aria-label="Use light theme" class="rounded px-2 py-1 hover:text-black dark:hover:text-white">light</button>
  <span aria-hidden="true">/</span>
  <button type="button" data-theme="dark" aria-label="Use dark theme" class="rounded px-2 py-1 hover:text-black dark:hover:text-white">dark</button>
  <span aria-hidden="true">/</span>
  <button type="button" data-theme="system" aria-label="Use system theme" class="rounded px-2 py-1 hover:text-black dark:hover:text-white">system</button>
</div>
