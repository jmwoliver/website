---
type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
};

const { href, external = false, underline = true, ...rest } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class:list={[
    "inline-block text-current transition-colors hover:text-ink dark:hover:text-paper",
    underline && "underline decoration-ink/20 underline-offset-2 dark:decoration-paper/30",
  ]}
  {...rest}
>
  <slot />
</a>
