<link
  rel="preload"
  href="/jmw-model.bin?v=geist-pixel-line-1"
  as="fetch"
  type="application/octet-stream"
  crossorigin="anonymous"
/>

<div class="jmw-mark" data-jmw-mark>
  <h1 class="jmw-mark__fallback">jmw</h1>
  <canvas class="jmw-mark__canvas" data-jmw-canvas aria-hidden="true"></canvas>
</div>

<script>
  const mark = document.querySelector<HTMLElement>("[data-jmw-mark]");
  const canvas = mark?.querySelector<HTMLCanvasElement>("[data-jmw-canvas]");

  const vertexShader = /* glsl */ `#version 300 es
    precision highp float;

    in vec3 aPosition;
    in vec3 aNormal;
    uniform float uAspect;
    uniform float uPositionScale;
    uniform vec2 uRotation;
    uniform vec2 uOffset;

    out vec3 vNormal;
    out vec3 vViewPosition;

    vec3 rotateX(vec3 point, float angle) {
      float sine = sin(angle);
      float cosine = cos(angle);
      return vec3(point.x, point.y * cosine - point.z * sine, point.y * sine + point.z * cosine);
    }

    vec3 rotateY(vec3 point, float angle) {
      float sine = sin(angle);
      float cosine = cos(angle);
      return vec3(point.x * cosine + point.z * sine, point.y, -point.x * sine + point.z * cosine);
    }

    vec3 rotateZ(vec3 point, float angle) {
      float sine = sin(angle);
      float cosine = cos(angle);
      return vec3(point.x * cosine - point.y * sine, point.x * sine + point.y * cosine, point.z);
    }

    vec3 transform(vec3 point) {
      return rotateZ(rotateY(rotateX(point, uRotation.x), uRotation.y), -0.015);
    }

    void main() {
      vec3 viewPosition = transform(aPosition / uPositionScale);
      viewPosition.xy += uOffset;
      viewPosition.z -= 15.0;

      vNormal = normalize(transform(aNormal));
      vViewPosition = viewPosition;

      float focalLength = 4.01078;
      float near = 0.1;
      float far = 100.0;
      gl_Position = vec4(
        viewPosition.x * focalLength / uAspect,
        viewPosition.y * focalLength,
        ((far + near) / (near - far)) * viewPosition.z + ((2.0 * far * near) / (near - far)),
        -viewPosition.z
      );
    }
  `;

  const surfaceFragmentShader = /* glsl */ `#version 300 es
    precision highp float;

    uniform vec3 uInk;
    uniform bool uDepthOnly;
    in vec3 vNormal;
    in vec3 vViewPosition;
    out vec4 outColor;

    float bayer4(vec2 position) {
      int x = int(mod(position.x, 4.0));
      int y = int(mod(position.y, 4.0));
      int index = x + y * 4;
      const float matrix[16] = float[16](
        0.0, 8.0, 2.0, 10.0,
        12.0, 4.0, 14.0, 6.0,
        3.0, 11.0, 1.0, 9.0,
        15.0, 7.0, 13.0, 5.0
      );
      return (matrix[index] + 0.5) / 16.0;
    }

    void main() {
      if (!uDepthOnly) {
        vec3 normal = normalize(vNormal);
        vec3 lightDirection = normalize(vec3(-0.5, 0.75, 1.0));
        vec3 viewDirection = normalize(-vViewPosition);
        float diffuse = dot(normal, lightDirection) * 0.5 + 0.5;
        float rim = pow(1.0 - max(0.0, dot(normal, viewDirection)), 2.0);
        float tone = clamp(0.14 + diffuse * 0.68 + rim * 0.18, 0.0, 1.0);
        if (tone < bayer4(gl_FragCoord.xy)) discard;
      }
      outColor = vec4(uInk, 1.0);
    }
  `;

  const lineFragmentShader = /* glsl */ `#version 300 es
    precision highp float;
    uniform vec3 uInk;
    out vec4 outColor;

    void main() {
      outColor = vec4(uInk, 1.0);
    }
  `;

  const pointVertexShader = /* glsl */ `#version 300 es
    precision highp float;

    in vec3 aPosition;
    in float aSize;
    uniform float uAspect;
    uniform vec2 uRotation;
    uniform vec2 uOffset;

    vec3 rotateX(vec3 point, float angle) {
      float sine = sin(angle);
      float cosine = cos(angle);
      return vec3(point.x, point.y * cosine - point.z * sine, point.y * sine + point.z * cosine);
    }

    vec3 rotateY(vec3 point, float angle) {
      float sine = sin(angle);
      float cosine = cos(angle);
      return vec3(point.x * cosine + point.z * sine, point.y, -point.x * sine + point.z * cosine);
    }

    vec3 rotateZ(vec3 point, float angle) {
      float sine = sin(angle);
      float cosine = cos(angle);
      return vec3(point.x * cosine - point.y * sine, point.x * sine + point.y * cosine, point.z);
    }

    void main() {
      vec3 viewPosition = rotateZ(
        rotateY(rotateX(aPosition, uRotation.x), uRotation.y),
        -0.015
      );
      viewPosition.xy += uOffset;
      viewPosition.z -= 15.0;

      float focalLength = 4.01078;
      float near = 0.1;
      float far = 100.0;
      gl_Position = vec4(
        viewPosition.x * focalLength / uAspect,
        viewPosition.y * focalLength,
        ((far + near) / (near - far)) * viewPosition.z + ((2.0 * far * near) / (near - far)),
        -viewPosition.z
      );

      // Nearby specks are a little larger, making the shallow motion read as depth.
      float proximity = clamp((viewPosition.z + 18.5) / 7.0, 0.0, 1.0);
      gl_PointSize = aSize * mix(1.0, 2.15, proximity);
    }
  `;

  if (mark && canvas) {
    void (async () => {
      const gl = canvas.getContext("webgl2", {
        alpha: true,
        antialias: false,
        powerPreference: "low-power",
      });
      if (!gl) {
        mark.dataset.ready = "fallback";
        return;
      }

      const compileShader = (type: number, source: string) => {
        const shader = gl.createShader(type);
        if (!shader) throw new Error("Unable to create WebGL shader.");
        gl.shaderSource(shader, source);
        gl.compileShader(shader);
        if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
          throw new Error(gl.getShaderInfoLog(shader) ?? "Unable to compile WebGL shader.");
        }
        return shader;
      };

      const createProgram = (fragmentSource: string, vertexSource = vertexShader) => {
        const program = gl.createProgram();
        if (!program) throw new Error("Unable to create WebGL program.");
        const vertex = compileShader(gl.VERTEX_SHADER, vertexSource);
        const fragment = compileShader(gl.FRAGMENT_SHADER, fragmentSource);
        gl.attachShader(program, vertex);
        gl.attachShader(program, fragment);
        gl.linkProgram(program);
        gl.deleteShader(vertex);
        gl.deleteShader(fragment);
        if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
          throw new Error(gl.getProgramInfoLog(program) ?? "Unable to link WebGL program.");
        }
        return program;
      };

      try {
        const response = await fetch("/jmw-model.bin?v=geist-pixel-line-1", {
          credentials: "omit",
        });
        if (!response.ok) throw new Error("Unable to load the JMW model.");
        const model = await response.arrayBuffer();
        const header = new DataView(model);
        const magic = String.fromCharCode(...new Uint8Array(model, 0, 4));
        if (magic !== "JMW2") throw new Error("Unsupported JMW model.");

        const triangleVertexCount = header.getUint32(4, true);
        const edgeVertexCount = header.getUint32(8, true);
        const positionScale = header.getFloat32(12, true);
        const triangleDataLength = triangleVertexCount * 6;
        const triangleData = new Int16Array(model, 16, triangleDataLength);
        const edgeData = new Int16Array(model, 16 + triangleData.byteLength, edgeVertexCount * 3);

        const surfaceProgram = createProgram(surfaceFragmentShader);
        const lineProgram = createProgram(lineFragmentShader);
        const pointProgram = createProgram(lineFragmentShader, pointVertexShader);
        const triangleBuffer = gl.createBuffer();
        const edgeBuffer = gl.createBuffer();
        const pointBuffer = gl.createBuffer();
        if (!triangleBuffer || !edgeBuffer || !pointBuffer) {
          throw new Error("Unable to create WebGL buffers.");
        }

        gl.bindBuffer(gl.ARRAY_BUFFER, triangleBuffer);
        gl.bufferData(gl.ARRAY_BUFFER, triangleData, gl.STATIC_DRAW);
        gl.bindBuffer(gl.ARRAY_BUFFER, edgeBuffer);
        gl.bufferData(gl.ARRAY_BUFFER, edgeData, gl.STATIC_DRAW);

        // A deterministic, sparse ellipsoid keeps every speck well inside the
        // narrowest version of the mark while still surrounding it in depth.
        const pointCount = 50;
        const pointData = new Float32Array(pointCount * 4);
        let seed = 0x6a6d77;
        const random = () => {
          seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
          return seed / 4294967296;
        };
        for (let index = 0; index < pointCount; index += 1) {
          const longitude = random() * Math.PI * 2;
          const latitude = Math.acos(random() * 2 - 1);
          const radius = 0.48 + Math.cbrt(random()) * 0.52;
          const offset = index * 4;
          pointData[offset] = Math.sin(latitude) * Math.cos(longitude) * radius * 5.8;
          pointData[offset + 1] = Math.cos(latitude) * radius * 2.7;
          pointData[offset + 2] = Math.sin(latitude) * Math.sin(longitude) * radius * 3.45;
          pointData[offset + 3] = 0.72 + random() * 0.48;
        }
        gl.bindBuffer(gl.ARRAY_BUFFER, pointBuffer);
        gl.bufferData(gl.ARRAY_BUFFER, pointData, gl.STATIC_DRAW);

        const surfaceLocations = {
          position: gl.getAttribLocation(surfaceProgram, "aPosition"),
          normal: gl.getAttribLocation(surfaceProgram, "aNormal"),
          aspect: gl.getUniformLocation(surfaceProgram, "uAspect"),
          positionScale: gl.getUniformLocation(surfaceProgram, "uPositionScale"),
          rotation: gl.getUniformLocation(surfaceProgram, "uRotation"),
          offset: gl.getUniformLocation(surfaceProgram, "uOffset"),
          ink: gl.getUniformLocation(surfaceProgram, "uInk"),
          depthOnly: gl.getUniformLocation(surfaceProgram, "uDepthOnly"),
        };
        const lineLocations = {
          position: gl.getAttribLocation(lineProgram, "aPosition"),
          aspect: gl.getUniformLocation(lineProgram, "uAspect"),
          positionScale: gl.getUniformLocation(lineProgram, "uPositionScale"),
          rotation: gl.getUniformLocation(lineProgram, "uRotation"),
          offset: gl.getUniformLocation(lineProgram, "uOffset"),
          ink: gl.getUniformLocation(lineProgram, "uInk"),
        };
        const pointLocations = {
          position: gl.getAttribLocation(pointProgram, "aPosition"),
          size: gl.getAttribLocation(pointProgram, "aSize"),
          aspect: gl.getUniformLocation(pointProgram, "uAspect"),
          rotation: gl.getUniformLocation(pointProgram, "uRotation"),
          offset: gl.getUniformLocation(pointProgram, "uOffset"),
          ink: gl.getUniformLocation(pointProgram, "uInk"),
        };

        const targetRotation = { x: -0.06, y: 0 };
        const rotation = { x: -0.06, y: 0 };
        const offset = { x: 0, y: 0 };
        const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
        let ink: [number, number, number] = [0.1804, 0.1882, 0.2157];
        let aspect = 1;
        let pointerActive = false;
        let frame = 0;
        let running = false;

        gl.enable(gl.DEPTH_TEST);
        gl.clearColor(0, 0, 0, 0);

        const setTransformUniforms = (
          locations: typeof surfaceLocations | typeof lineLocations,
          currentAspect: number,
        ) => {
          gl.uniform1f(locations.aspect, currentAspect);
          gl.uniform1f(locations.positionScale, positionScale);
          gl.uniform2f(locations.rotation, rotation.x, rotation.y);
          gl.uniform2f(locations.offset, offset.x, offset.y);
          gl.uniform3f(locations.ink, ink[0], ink[1], ink[2]);
        };

        const draw = (time = 0) => {
          if (!reducedMotion.matches) {
            if (!pointerActive) {
              targetRotation.x = -0.06 + Math.sin(time * 0.00033) * 0.055;
              targetRotation.y = Math.sin(time * 0.00026) * 0.15;
            }
            rotation.x += (targetRotation.x - rotation.x) * 0.055;
            rotation.y += (targetRotation.y - rotation.y) * 0.055;
            offset.x = Math.sin(time * 0.00021) * 0.055;
            offset.y = Math.sin(time * 0.00052) * 0.09;
          }

          gl.viewport(0, 0, gl.drawingBufferWidth, gl.drawingBufferHeight);
          gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);

          gl.useProgram(surfaceProgram);
          setTransformUniforms(surfaceLocations, aspect);
          gl.bindBuffer(gl.ARRAY_BUFFER, triangleBuffer);
          gl.enableVertexAttribArray(surfaceLocations.position);
          gl.vertexAttribPointer(surfaceLocations.position, 3, gl.SHORT, false, 12, 0);
          gl.enableVertexAttribArray(surfaceLocations.normal);
          gl.vertexAttribPointer(surfaceLocations.normal, 3, gl.SHORT, true, 12, 6);

          gl.colorMask(false, false, false, false);
          gl.uniform1i(surfaceLocations.depthOnly, 1);
          gl.depthFunc(gl.LESS);
          gl.drawArrays(gl.TRIANGLES, 0, triangleVertexCount);

          gl.colorMask(true, true, true, true);
          gl.uniform1i(surfaceLocations.depthOnly, 0);
          gl.depthFunc(gl.LEQUAL);
          gl.drawArrays(gl.TRIANGLES, 0, triangleVertexCount);

          gl.useProgram(lineProgram);
          setTransformUniforms(lineLocations, aspect);
          gl.bindBuffer(gl.ARRAY_BUFFER, edgeBuffer);
          gl.enableVertexAttribArray(lineLocations.position);
          gl.vertexAttribPointer(lineLocations.position, 3, gl.SHORT, false, 6, 0);
          gl.depthFunc(gl.LEQUAL);
          gl.drawArrays(gl.LINES, 0, edgeVertexCount);

          gl.useProgram(pointProgram);
          gl.uniform1f(pointLocations.aspect, aspect);
          gl.uniform2f(pointLocations.rotation, rotation.x, rotation.y);
          gl.uniform2f(pointLocations.offset, offset.x, offset.y);
          gl.uniform3f(pointLocations.ink, ink[0], ink[1], ink[2]);
          gl.bindBuffer(gl.ARRAY_BUFFER, pointBuffer);
          gl.enableVertexAttribArray(pointLocations.position);
          gl.vertexAttribPointer(pointLocations.position, 3, gl.FLOAT, false, 16, 0);
          gl.enableVertexAttribArray(pointLocations.size);
          gl.vertexAttribPointer(pointLocations.size, 1, gl.FLOAT, false, 16, 12);
          gl.depthFunc(gl.LEQUAL);
          gl.drawArrays(gl.POINTS, 0, pointCount);

          if (running) frame = requestAnimationFrame(draw);
        };

        const start = () => {
          if (running || reducedMotion.matches) return;
          running = true;
          frame = requestAnimationFrame(draw);
        };

        const stop = () => {
          running = false;
          cancelAnimationFrame(frame);
        };

        const updateInk = () => {
          ink = document.documentElement.classList.contains("dark")
            ? [0.9216, 0.898, 0.8078]
            : [0.1804, 0.1882, 0.2157];
          draw();
        };

        const resize = () => {
          const { width, height } = mark.getBoundingClientRect();
          const pixelScale = Math.min(devicePixelRatio, 1.35) * 0.72;
          canvas.width = Math.max(1, Math.round(width * pixelScale));
          canvas.height = Math.max(1, Math.round(height * pixelScale));
          aspect = width / height;
          draw();
        };

        const onPointerMove = (event: PointerEvent) => {
          if (reducedMotion.matches) return;
          const rect = mark.getBoundingClientRect();
          const x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
          const y = ((event.clientY - rect.top) / rect.height) * 2 - 1;
          pointerActive = true;
          targetRotation.x = -0.06 + y * 0.1;
          targetRotation.y = x * 0.22;
        };

        const onPointerLeave = () => {
          pointerActive = false;
        };

        const themeObserver = new MutationObserver(updateInk);
        const resizeObserver = new ResizeObserver(resize);
        const visibilityObserver = new IntersectionObserver(([entry]) => {
          if (entry?.isIntersecting) start();
          else stop();
        });

        themeObserver.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["class"],
        });
        resizeObserver.observe(mark);
        visibilityObserver.observe(mark);
        mark.addEventListener("pointermove", onPointerMove);
        mark.addEventListener("pointerleave", onPointerLeave);

        updateInk();
        resize();
        mark.dataset.ready = "true";

        document.addEventListener(
          "astro:before-swap",
          () => {
            stop();
            themeObserver.disconnect();
            resizeObserver.disconnect();
            visibilityObserver.disconnect();
            gl.deleteBuffer(triangleBuffer);
            gl.deleteBuffer(edgeBuffer);
            gl.deleteBuffer(pointBuffer);
            gl.deleteProgram(surfaceProgram);
            gl.deleteProgram(lineProgram);
            gl.deleteProgram(pointProgram);
          },
          { once: true },
        );
      } catch {
        mark.dataset.ready = "fallback";
      }
    })();
  }
</script>

<style>
  @font-face {
    font-family: "Geist Pixel Line";
    src: url("/fonts/GeistPixel-Line.woff2") format("woff2");
    font-style: normal;
    font-weight: 500;
    font-display: block;
  }

  .jmw-mark {
    position: relative;
    width: 100%;
    height: clamp(10rem, 30vw, 13rem);
    cursor: default;
    touch-action: pan-y;
  }

  .jmw-mark__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    opacity: 0;
    transition: opacity 220ms ease-out;
  }

  .jmw-mark__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--color-ink);
    font-family: "Geist Pixel Line", ui-monospace, "SFMono-Regular", Menlo, Monaco, Consolas, monospace;
    font-size: clamp(4.5rem, 18vw, 7.5rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
    opacity: 0;
    transition: opacity 160ms ease-out;
  }

  :global(.dark) .jmw-mark__fallback {
    color: var(--color-paper);
  }

  .jmw-mark:not([data-ready]) .jmw-mark__fallback {
    animation: jmw-fallback-reveal 180ms ease-out 180ms forwards;
  }

  .jmw-mark[data-ready="fallback"] .jmw-mark__fallback {
    opacity: 1;
  }

  .jmw-mark[data-ready="true"] .jmw-mark__canvas {
    opacity: 1;
  }

  .jmw-mark[data-ready="true"] .jmw-mark__fallback {
    opacity: 0;
  }

  @keyframes jmw-fallback-reveal {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jmw-mark__canvas,
    .jmw-mark__fallback {
      transition: none;
    }
  }
</style>
