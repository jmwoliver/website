---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import ThemeControls from "@components/ThemeControls.astro";
import { SITE } from "@consts";
---

<header class="site-header">
  <Container>
    <div class="flex flex-wrap items-center justify-between gap-y-2">
      <Link href="/" underline={false} aria-label="Jacob Woliver home">
        <span class="font-semibold text-ink dark:text-paper">{SITE.NAME}</span>
      </Link>
      <div class="flex items-center gap-3">
        <nav aria-label="Main navigation" class="flex gap-1 text-sm sm:text-base">
          <Link href="/blog/">blog</Link>
          <span aria-hidden="true">/</span>
          <Link href="/projects/">projects</Link>
          <span aria-hidden="true">/</span>
          <Link href="/games/">games</Link>
        </nav>
        <div class="flex items-center gap-1" aria-label="Site links and appearance">
          <a
            href="https://github.com/jmwoliver"
            target="_blank"
            rel="noopener noreferrer"
            class="icon-button"
            aria-label="GitHub"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.3-5.27-1.29-5.27-5.69 0-1.26.45-2.29 1.19-3.1-.12-.3-.52-1.47.11-3.06 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.28 5.68.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"></path>
            </svg>
          </a>
          <ThemeControls />
        </div>
      </div>
    </div>
  </Container>
</header>
